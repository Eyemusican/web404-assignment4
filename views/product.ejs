<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Product lookup</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 760px; margin: 40px auto; padding: 0 16px; }
    input { padding: 6px; width: 320px; }
    button { padding: 8px 16px; }
    table { border-collapse: collapse; margin-top: 16px; width: 100%; }
    th, td { border: 1px solid #ccc; padding: 6px 10px; text-align: left; }
    th { background: #f2f2f2; }
    .err { color: #a00; background: #fee; padding: 8px; white-space: pre-wrap; }
    a { display: inline-block; margin-top: 20px; }
  </style>
</head>
<body>
  <h1>3. Product lookup by id (error based)</h1>
  <form method="GET" action="/product">
    <input type="text" name="id" value="<%= id %>" autocomplete="off" placeholder="e.g. 1">
    <button type="submit">Look up</button>
  </form>

  <% if (row) { %>
    <table>
      <tr><th>id</th><th>name</th><th>price</th><th>category</th></tr>
      <tr>
        <td><%= row.id %></td>
        <td><%= row.name %></td>
        <td><%= row.price %></td>
        <td><%= row.category %></td>
      </tr>
    </table>
  <% } else if (id !== '') { %>
    <p>Product not found.</p>
  <% } %>

  <a href="/">&larr; Home</a>
</body>
</html>
