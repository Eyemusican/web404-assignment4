<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Product search</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 760px; margin: 40px auto; padding: 0 16px; }
    input { padding: 6px; width: 320px; }
    button { padding: 8px 16px; }
    table { border-collapse: collapse; margin-top: 16px; width: 100%; }
    th, td { border: 1px solid #ccc; padding: 6px 10px; text-align: left; }
    th { background: #f2f2f2; }
    .err { color: #a00; background: #fee; padding: 8px; white-space: pre-wrap; }
    a { display: inline-block; margin-top: 20px; }
  </style>
</head>
<body>
  <h1>2. Product search by category (UNION based)</h1>
  <form method="GET" action="/products">
    <input type="text" name="category" value="<%= category %>" autocomplete="off" placeholder="e.g. electronics">
    <button type="submit">Search</button>
  </form>

  <% if (error) { %>
    <p class="err"><%= error %></p>
  <% } else if (rows) { %>
    <table>
      <tr><th>id</th><th>name</th><th>price</th><th>category</th></tr>
      <% rows.forEach(function(r) { %>
        <tr>
          <td><%= r.id %></td>
          <td><%= r.name %></td>
          <td><%= r.price %></td>
          <td><%= r.category %></td>
        </tr>
      <% }); %>
    </table>
    <% if (rows.length === 0) { %><p>No products found.</p><% } %>
  <% } %>

  <a href="/">&larr; Home</a>
</body>
</html>
